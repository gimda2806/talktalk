// Cloudflare Workers 배포 설정: viewer/build.py 가 만든 viewer/dist 를 정적 사이트로 올리고,
// worker/index.js 가 /api/* (뷰어에서 고친 글을 GitHub 에 저장)를 맡는다.
// STILLS 는 관리자 전용 스틸컷 보관함(Workers KV). id 를 비워 두면 첫 배포 때 wrangler 가 알아서 만든다.
// 비밀값 GITHUB_TOKEN·EDIT_PASSWORD 는 대시보드나 `npx wrangler secret put` 으로 한 번 넣어 둔다 (README 참고).
{
  "name": "talktalk",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./viewer/dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "STILLS" }
  ]
}
